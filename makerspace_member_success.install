/**
 * Re-opens outreach files stuck closed across payment-failure episodes.
 *
 * One-time repair backing the 2026-08-17 policy decision (Kate): a NEW
 * payment-failure episode re-opens a member's outreach file. The snapshot
 * builder now does this on the flag's 0→1 transition, but members already
 * mid-episode at deploy time transitioned before the code existed, so their
 * stale snoozes / attempt counts / episode-scoped statuses from a PREVIOUS
 * episode still hide them from the actionable recovery queue (Sam Stoddard,
 * Zane Birks, Gabriel Harris, Azrael Von Kohler — feedback sid 20275).
 *
 * A member qualifies when currently payment-failed AND their last logged
 * contact predates the current episode's start (payment_failed_since), or
 * they were never contacted but carry an episode-resettable status.
 */
function makerspace_member_success_update_9032(): string {
  $database = \Drupal::database();
  $resettable = \Drupal\makerspace_member_success\Support\MemberSuccessLifecycle::followupStatusesResetOnNewPaymentEpisode();

  $rows = $database->select('ms_member_success_snapshot', 'ms')
    ->fields('ms', ['id', 'uid', 'member_followup_status', 'last_contact_date', 'payment_failed_since', 'next_followup_date', 'contact_count'])
    ->condition('is_latest', 1)
    ->condition('snapshot_type', 'daily')
    ->condition('payment_failed', 1)
    ->execute()
    ->fetchAll(\Drupal\Core\Database\Statement\FetchAs::Associative);

  $reset_uids = [];
  foreach ($rows as $row) {
    $since = (string) ($row['payment_failed_since'] ?? '');
    if ($since === '') {
      // Unknown episode start — leave untouched rather than guess.
      continue;
    }
    $last_contact = (string) ($row['last_contact_date'] ?? '');
    $stale_contact = $last_contact === '' || $last_contact < $since;
    if (!$stale_contact) {
      continue;
    }
    $has_stale_state = !empty($row['next_followup_date'])
      || (int) $row['contact_count'] > 0
      || in_array($row['member_followup_status'], $resettable, TRUE);
    if (!$has_stale_state) {
      continue;
    }

    $fields = [
      'last_outreach_ts' => NULL,
      'outreach_status' => NULL,
      'last_contact_date' => NULL,
      'next_followup_date' => NULL,
      'contact_count' => 0,
    ];
    if (in_array($row['member_followup_status'], $resettable, TRUE)) {
      $fields['member_followup_status'] = NULL;
    }
    $database->update('ms_member_success_snapshot')
      ->fields($fields)
      ->condition('id', $row['id'])
      ->execute();

    // Clear the user-level status too (no-op unless episode-resettable);
    // propagates to CiviCRM groups / Chargebee like any status change.
    \Drupal::service('makerspace_member_success.followup_status_manager')
      ->clearStatusForNewEpisode((int) $row['uid']);

    $reset_uids[] = (int) $row['uid'];
  }

  $message = count($reset_uids) . ' outreach file(s) re-opened for the current payment-failure episode'
    . ($reset_uids ? ' (uids: ' . implode(', ', $reset_uids) . ')' : '') . '.';
  \Drupal::logger('makerspace_member_success')->notice($message);
  return $message;
}

/**
 * Add the cron snapshot time budget so the build can no longer starve cron.
 */
function makerspace_member_success_update_9033(): string {
  $config = \Drupal::configFactory()->getEditable('makerspace_member_success.settings');
  $existing = $config->get('snapshot_cron_time_budget');
  if ($existing === NULL || (int) $existing <= 0) {
    $config->set('snapshot_cron_time_budget', 45)->save();
    return 'Set snapshot_cron_time_budget to 45 seconds.';
  }
  return 'snapshot_cron_time_budget already set to ' . (int) $existing . ' seconds; left as is.';
}

/**
 * Adds pending-badge measurement to the member success snapshot.
 */
function makerspace_member_success_update_9034(): string {
  $schema = \Drupal::database()->schema();
  $added = [];

  $fields = [
    'badge_pending_count' => [
      'type' => 'int',
      'not null' => FALSE,
      'description' => 'Distinct badges the member passed the quiz for but cannot use yet.',
    ],
    'badge_pending_oldest_ts' => [
      'type' => 'int',
      'not null' => FALSE,
      'description' => 'Unix ts the oldest still-pending badge was requested.',
    ],
  ];

  foreach ($fields as $name => $spec) {
    if (!$schema->fieldExists('ms_member_success_snapshot', $name)) {
      $schema->addField('ms_member_success_snapshot', $name, $spec);
      $added[] = $name;
    }
  }

  // Deliberately no backfill. These are measured forward from the next
  // snapshot pass: the value of the field is the daily series it builds, and a
  // synthesised history would read as measurement that never happened.
  return $added
    ? 'Added ' . implode(', ', $added) . ' to ms_member_success_snapshot. Values populate from the next snapshot run.'
    : 'Pending-badge snapshot fields already present.';
}

/**
 * Installs the badge-nudge settings (ships dark).
 */
function makerspace_member_success_update_9035(): string {
  $config = \Drupal::configFactory()->getEditable('makerspace_member_success.settings');

  // Only seed keys that are absent, so a site that has already tuned any of
  // these keeps its values.
  $defaults = [
    'badge_nudge_enabled' => FALSE,
    'badge_nudge_min_age_days' => 14,
    // Holds the ~531-member backlog out of any automated send. See
    // docs/proposals/BADGE_NUDGE_PLAN.md before raising it.
    'badge_nudge_max_age_days' => 90,
    'badge_nudge_max_badges_listed' => 6,
    'stage_badge_cooldown_days' => 45,
    'stage_badge_max_attempts' => 2,
    'stage_badge_min_risk_to_contact' => 0,
    'stage_badge_require_manual_approval' => TRUE,
  ];

  $seeded = [];
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
      $seeded[] = $key;
    }
  }

  if ($config->get('template_badge') === NULL) {
    $install = \Drupal::service('extension.list.module')->getPath('makerspace_member_success')
      . '/config/install/makerspace_member_success.settings.yml';
    $shipped = is_readable($install)
      ? (\Symfony\Component\Yaml\Yaml::parse(file_get_contents($install))['template_badge'] ?? '')
      : '';
    if ($shipped !== '') {
      $config->set('template_badge', $shipped);
      $seeded[] = 'template_badge';
    }
  }

  $config->save();

  return $seeded
    ? 'Seeded badge-nudge settings: ' . implode(', ', $seeded) . '. Nothing sends until badge_nudge_enabled is TRUE.'
    : 'Badge-nudge settings already present.';
}
