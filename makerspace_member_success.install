        ],
        'contact_method' => [
          'type' => 'varchar',
          'length' => 32,
          'not null' => TRUE,
          'description' => 'phone, email, in_person, other',
        ],
        'outcome' => [
          'type' => 'varchar',
          'length' => 64,
          'not null' => TRUE,
          'description' => 'Contact outcome',
        ],
        'notes' => [
          'type' => 'text',
          'not null' => FALSE,
          'description' => 'Staff notes about conversation',
        ],
        'followup_status' => [
          'type' => 'varchar',
          'length' => 64,
          'not null' => FALSE,
          'description' => 'New followup status set',
        ],
        'staff_uid' => [
          'type' => 'int',
          'not null' => FALSE,
          'description' => 'Staff member who made contact',
