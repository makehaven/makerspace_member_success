/**
 * Adds provider_message_id column to outreach queue table.
 *
 * Previously, the provider-assigned message ID (e.g. Twilio SID) was incorrectly
 * stored in the failure_message column with a "provider_message_id:" prefix.
 * This column gives it a proper home.
 */
function makerspace_member_success_update_9022(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->fieldExists('ms_member_outreach_queue', 'provider_message_id')) {
    $schema->addField('ms_member_outreach_queue', 'provider_message_id', [
      'type' => 'varchar',
      'length' => 255,
      'not null' => FALSE,
      'description' => 'Provider-assigned message ID returned on successful send (e.g. Twilio SID).',
    ]);
  }

  // Migrate any existing encoded values out of failure_message.
  $database = \Drupal::database();
  $database->query("
    UPDATE {ms_member_outreach_queue}
    SET provider_message_id = SUBSTRING(failure_message, LENGTH('provider_message_id:') + 1),
        failure_message = NULL
    WHERE failure_message LIKE 'provider_message_id:%'
  ");
}

