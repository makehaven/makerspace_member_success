          'type' => 'varchar',
          'length' => 64,
          'not null' => FALSE,
        ],
        'destination_email' => [
          'type' => 'varchar',
          'length' => 255,
          'not null' => FALSE,
        ],
        'destination_phone' => [
          'type' => 'varchar',
