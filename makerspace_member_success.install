        'notes' => [
          'type' => 'text',
          'not null' => FALSE,
          'description' => 'Staff notes about conversation',
        ],
        'followup_status' => [
          'type' => 'varchar',
          'length' => 64,
          'not null' => FALSE,
          'description' => 'New followup status set',
        ],
        'staff_uid' => [
          'type' => 'int',
          'not null' => FALSE,
          'description' => 'Staff member who made contact',
        ],
        'civicrm_activity_id' => [
          'type' => 'int',
          'not null' => FALSE,
          'description' => 'CiviCRM activity ID if created',
        ],
        'sleep_days' => [
          'type' => 'int',
          'not null' => FALSE,
          'description' => 'Sleep period applied (days)',
        ],
        'created_at' => [
          'type' => 'int',
          'not null' => TRUE,
          'description' => 'Unix timestamp',
        ],
      ],
      'primary key' => ['id'],
      'indexes' => [
        'idx_uid' => ['uid'],
        'idx_contact_date' => ['contact_date'],
        'idx_outcome' => ['outcome'],
        'idx_created_at' => ['created_at'],
      ],
    ];

    $schema->createTable('ms_member_outreach_log', $table_schema);
  }
}

/**
