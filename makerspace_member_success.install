      'payment_pause' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'payment_status' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
