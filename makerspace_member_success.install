          'type' => 'varchar',
          'length' => 10,
          'not null' => TRUE,
          'description' => 'Date contact was attempted (YYYY-MM-DD).',
        ],
        'contact_method' => [
          'type' => 'varchar',
          'length' => 32,
          'not null' => TRUE,
          'description' => 'phone, email, in_person, other.',
        ],
        'outcome' => [
          'type' => 'varchar',
          'length' => 64,
          'not null' => TRUE,
          'description' => 'Contact outcome.',
        ],
        'notes' => [
          'type' => 'text',
          'not null' => FALSE,
          'description' => 'Staff notes about conversation.',
        ],
        'followup_status' => [
          'type' => 'varchar',
          'length' => 64,
          'not null' => FALSE,
          'description' => 'Followup status applied after contact.',
        ],
        'staff_uid' => [
          'type' => 'int',
          'not null' => FALSE,
          'description' => 'Staff member who made contact.',
        ],
        'civicrm_activity_id' => [
          'type' => 'int',
          'not null' => FALSE,
          'description' => 'CiviCRM activity ID if created.',
        ],
        'sleep_days' => [
          'type' => 'int',
          'not null' => FALSE,
          'description' => 'Sleep period applied (days).',
        ],
        'created_at' => [
          'type' => 'int',
          'not null' => TRUE,
          'description' => 'Unix timestamp.',
        ],
        'recommended_channel' => [
          'type' => 'varchar',
          'length' => 16,
          'not null' => FALSE,
          'description' => 'System-recommended channel (sms, email, manual_only).',
        ],
        'recommended_template_id' => [
          'type' => 'varchar',
          'length' => 64,
          'not null' => FALSE,
          'description' => 'Template selected by policy recommendation.',
        ],
        'recommended_reason_code' => [
          'type' => 'varchar',
          'length' => 64,
          'not null' => FALSE,
          'description' => 'Reason code for recommendation.',
        ],
        'actual_template_id' => [
          'type' => 'varchar',
          'length' => 64,
          'not null' => FALSE,
          'description' => 'Template actually used by staff.',
        ],
        'override_reason_code' => [
          'type' => 'varchar',
          'length' => 64,
          'not null' => FALSE,
          'description' => 'Reason why staff overrode recommendation.',
