<?php

/**
 * @file
 * Install file for makerspace_member_success.
 */

use Drupal\Component\Serialization\Yaml;

/**
 * Implements hook_install().
 */
function makerspace_member_success_install(): void {
  makerspace_member_success_import_view_config();
  \Drupal::service('router.builder')->rebuild();
}

/**
 * Implements hook_schema().
 */
function makerspace_member_success_schema() {
  $schema = [];
  $table_name = 'ms_member_success_snapshot';

  // Skip createTable during install if the table already exists from a prior
  // attempt. We key off system.schema so uninstall can still discover tables.
  $schema_api = \Drupal::database()->schema();
  $schema_version = \Drupal::keyValue('system.schema')
    ->get('makerspace_member_success');
  if (!$schema_api->tableExists($table_name) || $schema_version !== NULL) {
    $schema[$table_name] = [
    'description' => 'Member-level success snapshots for onboarding, engagement, and retention.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
      ],
      'uid' => [
        'type' => 'int',
        'not null' => TRUE,
      ],
      'snapshot_date' => [
        'type' => 'varchar',
        'length' => 10,
        'not null' => TRUE,
        'description' => 'YYYY-MM-DD',
      ],
      'snapshot_type' => [
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
        'default' => 'daily',
      ],
      'stage' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'onboarding',
      ],
      'risk_score' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
      'risk_reasons' => [
        'type' => 'blob',
        'not null' => FALSE,
        'serialize' => TRUE,
      ],
      'join_date' => [
        'type' => 'varchar',
        'length' => 10,
        'not null' => FALSE,
      ],
      'orientation_date' => [
        'type' => 'varchar',
        'length' => 10,
        'not null' => FALSE,
      ],
      'orientation_scheduled_date' => [
        'type' => 'varchar',
        'length' => 10,
        'not null' => FALSE,
        'description' => 'Date of upcoming scheduled orientation in CiviCRM (YYYY-MM-DD).',
      ],
      'first_card_scan_date' => [
        'type' => 'varchar',
        'length' => 10,
        'not null' => FALSE,
        'description' => 'Date of first successful door card scan (YYYY-MM-DD).',
      ],
      'onboarding_step' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => FALSE,
        'description' => 'For onboarding-stage members, the next incomplete funnel step (account|profile|video|quiz|schedule|involve|done). See OnboardingFunnel.',
      ],
      'onboarding_step_ts' => [
        'type' => 'int',
        'not null' => FALSE,
        'description' => 'Unix ts the member reached their current onboarding step (last completed step). Anchors stall measurement.',
      ],
      'door_badge_status' => [
        'type' => 'varchar',
        'length' => 16,
        'not null' => FALSE,
      ],
      'serial_number_present' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'badge_count_total' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
      'badge_count_window' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
      'badge_pending_count' => [
        'type' => 'int',
        'not null' => FALSE,
        'description' => 'Distinct badges the member passed the quiz for but cannot use yet — checkout-required, has an issuer, not already held. See MemberSuccessSnapshotBuilder::loadPendingBadgeStats().',
      ],
      'badge_pending_oldest_ts' => [
        'type' => 'int',
        'not null' => FALSE,
        'description' => 'Unix ts the oldest still-pending badge was requested. Anchors stall measurement the way onboarding_step_ts does.',
      ],
      'tenure_bucket' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => FALSE,
      ],
      'membership_type' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
      ],
      'last_badge_ts' => [
        'type' => 'int',
        'not null' => FALSE,
      ],
      'last_visit_ts' => [
        'type' => 'int',
        'not null' => FALSE,
      ],
      'visit_count_30d' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
      'payment_failed' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'payment_failed_since' => [
        'type' => 'varchar',
        'length' => 10,
        'not null' => FALSE,
        'description' => 'Date the current payment failure began (YYYY-MM-DD). Tracks dunning window age.',
      ],
      'payment_pause' => [
        'type' => 'int',
        'size' => 'tiny',
