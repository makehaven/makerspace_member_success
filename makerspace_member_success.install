/**
 * Adds is_latest to member success snapshots.
 */
function makerspace_member_success_update_9007(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->fieldExists('ms_member_success_snapshot', 'is_latest')) {
    $schema->addField('ms_member_success_snapshot', 'is_latest', [
      'type' => 'int',
      'size' => 'tiny',
      'not null' => TRUE,
      'default' => 0,
    ]);
    $schema->addIndex('ms_member_success_snapshot', 'is_latest', ['is_latest'], [
      'fields' => [
        'is_latest' => [
          'type' => 'int',
          'size' => 'tiny',
          'not null' => TRUE,
          'default' => 0,
        ],
      ],
    ]);
  }
}

