/**
 * Normalizes followup config key and migrates legacy followup field values.
 */
function makerspace_member_success_update_9018(): void {
  $config = \Drupal::configFactory()->getEditable('makerspace_member_success.settings');
  $legacy_key = 'civicrm_member_followup_status_field';
  $canonical_key = 'civicrm_member_followup_field';
  $legacy_value = $config->get($legacy_key);
  $canonical_value = $config->get($canonical_key);

  if ($canonical_value === NULL && $legacy_value !== NULL) {
    $config->set($canonical_key, $legacy_value);
  }
  if ($legacy_value !== NULL) {
    $config->clear($legacy_key);
  }
  $config->save(TRUE);

  $field_manager = \Drupal::service('entity_field.manager');
  $definitions = $field_manager->getFieldDefinitions('user', 'user');
  if (
    empty($definitions['field_member_followup_status'])
    || empty($definitions['field_chargebee_followup'])
  ) {
    return;
  }

  $user_storage = \Drupal::entityTypeManager()->getStorage('user');
  $uids = \Drupal::entityQuery('user')
    ->accessCheck(FALSE)
    ->condition('field_chargebee_followup', NULL, 'IS NOT NULL')
    ->execute();

  if (empty($uids)) {
    return;
  }

  $migrated = 0;
  foreach (array_chunk(array_values($uids), 100) as $chunk) {
    $users = $user_storage->loadMultiple($chunk);
    foreach ($users as $user) {
      if (
        !$user->hasField('field_member_followup_status')
        || !$user->hasField('field_chargebee_followup')
      ) {
        continue;
      }

      $legacy_status = trim((string) $user->get('field_chargebee_followup')->value);
      $current_status = trim((string) $user->get('field_member_followup_status')->value);
      if ($legacy_status !== '' && $current_status === '') {
        $user->set('field_member_followup_status', $legacy_status);
        $user->save();
        $migrated++;
      }
    }
  }

  if ($migrated > 0) {
    \Drupal::logger('makerspace_member_success')->notice('Migrated @count legacy followup values to field_member_followup_status.', [
      '@count' => $migrated,
    ]);
  }
}

