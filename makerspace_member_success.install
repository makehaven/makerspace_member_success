/**
 * Rename snapshot column cancellation_followup → member_followup_status.
 */
function makerspace_member_success_update_9010(): void {
  $schema = \Drupal::database()->schema();
  if ($schema->fieldExists('ms_member_success_snapshot', 'cancellation_followup')) {
    $schema->changeField('ms_member_success_snapshot', 'cancellation_followup', 'member_followup_status', [
      'type' => 'varchar',
      'length' => 64,
      'not null' => FALSE,
    ]);
  }
}

/**
 * Rename civicrm_cancellation_followup_field config key → civicrm_member_followup_field.
 */
function makerspace_member_success_update_9011(): void {
  $config = \Drupal::configFactory()->getEditable('makerspace_member_success.settings');
  $old_value = $config->get('civicrm_cancellation_followup_field');
  if ($config->get('civicrm_member_followup_field') === NULL && $old_value !== NULL) {
    $config->set('civicrm_member_followup_field', $old_value);
    $config->clear('civicrm_cancellation_followup_field');
    $config->save();
  }
}

/**
 * Rename Drupal field field_chargebee_followup → field_member_followup_status.
 *
 * Renames DB tables and columns, then updates the active config table and all
 * relevant key_value caches so that drush cr proceeds cleanly.
 */
function makerspace_member_success_update_9012(): void {
  $database = \Drupal::database();
  $schema = $database->schema();

  // Step 1: Rename main field table.
  if ($schema->tableExists('user__field_chargebee_followup')) {
    $schema->renameTable('user__field_chargebee_followup', 'user__field_member_followup_status');
  }

  // Step 2: Rename revision table.
  if ($schema->tableExists('user_revision__field_chargebee_followup')) {
    $schema->renameTable('user_revision__field_chargebee_followup', 'user_revision__field_member_followup_status');
  }

  // Step 3: Rename value column in main table.
  if ($schema->tableExists('user__field_member_followup_status')
    && $schema->fieldExists('user__field_member_followup_status', 'field_chargebee_followup_value')) {
    $schema->changeField(
      'user__field_member_followup_status',
      'field_chargebee_followup_value',
      'field_member_followup_status_value',
      ['type' => 'varchar', 'length' => 255, 'not null' => FALSE]
    );
  }

  // Step 4: Rename value column in revision table.
  if ($schema->tableExists('user_revision__field_member_followup_status')
    && $schema->fieldExists('user_revision__field_member_followup_status', 'field_chargebee_followup_value')) {
    $schema->changeField(
      'user_revision__field_member_followup_status',
      'field_chargebee_followup_value',
      'field_member_followup_status_value',
      ['type' => 'varchar', 'length' => 255, 'not null' => FALSE]
    );
  }

  // Step 5: Update field config in the active config table.
  // Drupal stores active config in the `config` DB table (not key_value).
  $old_storage_name = 'field.storage.user.field_chargebee_followup';
  $new_storage_name = 'field.storage.user.field_member_followup_status';
  $old_field_name   = 'field.field.user.user.field_chargebee_followup';
  $new_field_name   = 'field.field.user.user.field_member_followup_status';

  $config_storage = \Drupal::service('config.storage');

  if ($config_storage->exists($old_storage_name)) {
    $storage_data = $config_storage->read($old_storage_name);
    $storage_data['id']         = 'user.field_member_followup_status';
    $storage_data['field_name'] = 'field_member_followup_status';
    // Add no_action_needed to allowed values if missing.
    $has_no_action = FALSE;
    foreach ($storage_data['settings']['allowed_values'] ?? [] as $av) {
      if ($av['value'] === 'no_action_needed') {
        $has_no_action = TRUE;
        break;
      }
    }
    if (!$has_no_action) {
      $storage_data['settings']['allowed_values'][] = [
        'value' => 'no_action_needed',
        'label' => 'No Action Needed',
      ];
    }
    $config_storage->write($new_storage_name, $storage_data);
    $config_storage->delete($old_storage_name);
  }

  if ($config_storage->exists($old_field_name)) {
    $field_data = $config_storage->read($old_field_name);
    $field_data['id']         = 'user.user.field_member_followup_status';
    $field_data['field_name'] = 'field_member_followup_status';
    $field_data['label']      = 'Member Followup Status';
    if (isset($field_data['dependencies']['config'])) {
      $field_data['dependencies']['config'] = array_map(
        fn($c) => str_replace('field_chargebee_followup', 'field_member_followup_status', $c),
        $field_data['dependencies']['config']
      );
    }
    $config_storage->write($new_field_name, $field_data);
    $config_storage->delete($old_field_name);
  }

  // Step 6: Migrate entity.storage_schema.sql key_value entry.
  $kv_schema = \Drupal::keyValue('entity.storage_schema.sql');
  $old_schema_key = 'user.field_schema_data.field_chargebee_followup';
  $new_schema_key = 'user.field_schema_data.field_member_followup_status';
  $old_schema = $kv_schema->get($old_schema_key);
  if ($old_schema) {
    // Remap table names and column names using JSON round-trip for simplicity.
    $new_schema = json_decode(
      str_replace('field_chargebee_followup', 'field_member_followup_status', json_encode($old_schema)),
      TRUE
    );
    $kv_schema->set($new_schema_key, $new_schema);
    $kv_schema->delete($old_schema_key);
  }

  // Step 7: Update UUID key stores and cached definition maps in key_value.
  $kv_cfg_fc  = \Drupal::keyValue('config.entity.key_store.field_config');
  $kv_cfg_fsc = \Drupal::keyValue('config.entity.key_store.field_storage_config');
  foreach ($kv_cfg_fc->getAll() as $k => $v) {
    $new_v = array_map(fn($n) => str_replace('field_chargebee_followup', 'field_member_followup_status', $n), $v);
    if ($new_v !== $v) {
      $kv_cfg_fc->set($k, $new_v);
    }
  }
  foreach ($kv_cfg_fsc->getAll() as $k => $v) {
    $new_v = array_map(fn($n) => str_replace('field_chargebee_followup', 'field_member_followup_status', $n), $v);
    if ($new_v !== $v) {
      $kv_cfg_fsc->set($k, $new_v);
    }
  }

  // Step 8: Delete stale cached field/bundle definitions (rebuilt automatically).
  \Drupal::keyValue('entity.definitions.installed')->delete('user.field_storage_definitions');
  \Drupal::keyValue('entity.definitions.bundle_field_map')->delete('user');

  // Step 9: Invalidate entity/field definition caches.
  \Drupal::entityTypeManager()->clearCachedDefinitions();
  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
}

/**
 * Re-import member success queue view to use the linked member name field.
 */
function makerspace_member_success_update_9013(): void {
  makerspace_member_success_import_view_config();
}

/**
 * Forces queue name fields to use the linked member-name field plugin.
 */
function makerspace_member_success_update_9014(): void {
  $editable = \Drupal::configFactory()->getEditable('views.view.member_success_queue');
  $displays = $editable->get('display');
  if (!is_array($displays) || empty($displays)) {
    return;
  }

  foreach ($displays as $display_id => $display) {
    $path = "display.$display_id.display_options.fields.name";
    $name_field = $editable->get($path);
    if (!is_array($name_field)) {
      continue;
    }

    $name_field['table'] = 'ms_member_success_snapshot';
    $name_field['field'] = 'member_name_with_ids';
    $name_field['relationship'] = 'none';
    $name_field['plugin_id'] = 'member_name_with_ids_field';
    $name_field['alter']['alter_text'] = FALSE;
    $name_field['alter']['text'] = '';
    $name_field['alter']['word_boundary'] = TRUE;
    $name_field['alter']['ellipsis'] = TRUE;

    $editable->set($path, $name_field);
  }

  $editable->save(TRUE);
}

/**
 * Adds outreach queue table, extends outreach log, and seeds automation config.
 */
function makerspace_member_success_update_9015(): void {
  $schema = \Drupal::database()->schema();

  if (!$schema->tableExists('ms_member_outreach_queue')) {
    $schema->createTable('ms_member_outreach_queue', [
      'description' => 'Queue for manual/automated member outreach actions.',
      'fields' => [
        'id' => ['type' => 'serial', 'not null' => TRUE],
        'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
        'civicrm_contact_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
        'stage' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE],
        'risk_score' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
        'risk_reasons' => ['type' => 'blob', 'not null' => FALSE, 'serialize' => TRUE],
        'recommended_channel' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE],
        'recommended_template_id' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
        'recommended_reason_code' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
        'actual_channel' => ['type' => 'varchar', 'length' => 16, 'not null' => FALSE],
        'actual_template_id' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
        'override_reason_code' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
        'destination_email' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE],
        'destination_phone' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
        'consent_snapshot' => ['type' => 'blob', 'not null' => FALSE, 'serialize' => TRUE],
        'policy_version' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => 'v1'],
        'status' => ['type' => 'varchar', 'length' => 24, 'not null' => TRUE, 'default' => 'queued'],
        'suppression_reason_code' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
        'failure_code' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
        'failure_message' => ['type' => 'text', 'not null' => FALSE],
        'scheduled_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
        'approved_by_uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
        'approved_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
        'sent_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
        'locked_by' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
        'locked_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
        'created_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
        'updated_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      ],
      'primary key' => ['id'],
      'indexes' => [
        'idx_status_scheduled' => ['status', 'scheduled_at'],
        'idx_uid_status' => ['uid', 'status'],
        'idx_stage_status' => ['stage', 'status'],
        'idx_locked' => ['locked_at'],
      ],
    ]);
  }

  $log_fields = [
    'recommended_channel' => [
      'type' => 'varchar',
      'length' => 16,
      'not null' => FALSE,
      'description' => 'System-recommended channel (sms, email, manual_only).',
    ],
    'recommended_template_id' => [
      'type' => 'varchar',
      'length' => 64,
      'not null' => FALSE,
      'description' => 'Template selected by policy recommendation.',
    ],
    'recommended_reason_code' => [
      'type' => 'varchar',
      'length' => 64,
      'not null' => FALSE,
      'description' => 'Reason code for recommendation.',
    ],
    'actual_template_id' => [
      'type' => 'varchar',
      'length' => 64,
      'not null' => FALSE,
      'description' => 'Template actually used by staff.',
    ],
    'override_reason_code' => [
      'type' => 'varchar',
      'length' => 64,
      'not null' => FALSE,
      'description' => 'Reason why staff overrode recommendation.',
    ],
    'queue_id' => [
      'type' => 'int',
      'unsigned' => TRUE,
      'not null' => FALSE,
      'description' => 'Related queue item ID if originated from queue.',
    ],
  ];

  foreach ($log_fields as $field_name => $definition) {
    if (!$schema->fieldExists('ms_member_outreach_log', $field_name)) {
      $schema->addField('ms_member_outreach_log', $field_name, $definition);
    }
  }

  if (!$schema->indexExists('ms_member_outreach_log', 'idx_queue_id')) {
    $schema->addIndex('ms_member_outreach_log', 'idx_queue_id', ['queue_id'], [
      'fields' => [
        'queue_id' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => FALSE,
        ],
      ],
    ]);
  }

  $config = \Drupal::configFactory()->getEditable('makerspace_member_success.settings');
  $defaults = [
    'automation_enabled' => FALSE,
    'automation_policy_version' => 'v1',
    'outreach_send_hour_local' => 10,
    'pause_all' => FALSE,
    'pause_email' => FALSE,
    'pause_sms' => FALSE,
    'stage_onboarding_min_risk_to_contact' => 20,
    'stage_onboarding_cooldown_days' => 7,
    'stage_onboarding_max_attempts' => 3,
    'stage_onboarding_require_manual_approval' => TRUE,
    'stage_engagement_min_risk_to_contact' => 20,
    'stage_engagement_cooldown_days' => 7,
    'stage_engagement_max_attempts' => 3,
    'stage_engagement_require_manual_approval' => TRUE,
    'stage_retention_min_risk_to_contact' => 20,
    'stage_retention_cooldown_days' => 7,
    'stage_retention_max_attempts' => 3,
    'stage_retention_require_manual_approval' => TRUE,
    'stage_recovery_min_risk_to_contact' => 20,
    'stage_recovery_cooldown_days' => 7,
    'stage_recovery_max_attempts' => 3,
    'stage_recovery_require_manual_approval' => TRUE,
  ];

  $changed = FALSE;
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
      $changed = TRUE;
    }
  }
  if ($changed) {
    $config->save(TRUE);
  }
}

