/**
 * Schema definition for the onboarding lead table.
 *
 * Tracks join-form submitters who have not (yet) created a paid account, so
 * staff can follow up and an optional auto-email can nudge them to finish.
 * One row per email (deduped across repeat submissions).
 *
 * @return array
 *   Drupal schema array for ms_onboarding_lead.
 */
function _makerspace_member_success_lead_table_schema(): array {
  return [
    'description' => 'Join-form submitters with no paid account yet (unpaid onboarding leads).',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'email' => [
        'type' => 'varchar',
        'length' => 254,
        'not null' => TRUE,
        'description' => 'Submitted email, lower-cased for dedupe.',
      ],
      'name' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
      ],
      'first_sid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
        'description' => 'Latest join webform submission id for this email.',
      ],
      'submitted_ts' => [
        'type' => 'int',
        'not null' => FALSE,
        'description' => 'Unix ts of the latest join submission.',
      ],
      'submission_count' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 1,
      ],
      'status' => [
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
        'default' => 'unpaid',
        'description' => 'unpaid | converted | dismissed.',
      ],
      'followup_sent_ts' => [
        'type' => 'int',
        'not null' => FALSE,
        'description' => 'Unix ts the auto follow-up email was sent (NULL = not sent).',
      ],
      'converted_uid' => [
        'type' => 'int',
        'not null' => FALSE,
        'description' => 'User id once the lead created an account.',
      ],
      'converted_ts' => [
        'type' => 'int',
        'not null' => FALSE,
      ],
      'created_at' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
      'updated_at' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'uniq_email' => ['email'],
    ],
    'indexes' => [
      'idx_status' => ['status'],
      'idx_followup' => ['status', 'followup_sent_ts'],
    ],
  ];
}

/**
 * Adds is_latest to member success snapshots.
 */
function makerspace_member_success_update_9007(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->fieldExists('ms_member_success_snapshot', 'is_latest')) {
    $schema->addField('ms_member_success_snapshot', 'is_latest', [
      'type' => 'int',
      'size' => 'tiny',
      'not null' => TRUE,
      'default' => 0,
    ]);
    $schema->addIndex('ms_member_success_snapshot', 'is_latest', ['is_latest'], [
      'fields' => [
        'is_latest' => [
          'type' => 'int',
          'size' => 'tiny',
          'not null' => TRUE,
          'default' => 0,
        ],
      ],
    ]);
  }
}

