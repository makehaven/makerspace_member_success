<?php

/**
 * @file
 * Install file for makerspace_member_success.
 */

use Drupal\Component\Serialization\Yaml;

/**
 * Implements hook_install().
 */
function makerspace_member_success_install(): void {
  makerspace_member_success_import_view_config();
  \Drupal::service('router.builder')->rebuild();
}

/**
 * Implements hook_schema().
 */
function makerspace_member_success_schema() {
  $schema = [];
  $table_name = 'ms_member_success_snapshot';

  // Skip createTable during install if the table already exists from a prior
  // attempt. We key off system.schema so uninstall can still discover tables.
  $schema_api = \Drupal::database()->schema();
  $schema_version = \Drupal::keyValue('system.schema')
    ->get('makerspace_member_success');
  if (!$schema_api->tableExists($table_name) || $schema_version !== NULL) {
    $schema[$table_name] = [
    'description' => 'Member-level success snapshots for onboarding, engagement, and retention.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
      ],
      'uid' => [
        'type' => 'int',
        'not null' => TRUE,
      ],
      'snapshot_date' => [
        'type' => 'varchar',
        'length' => 10,
        'not null' => TRUE,
        'description' => 'YYYY-MM-DD',
      ],
      'snapshot_type' => [
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
        'default' => 'daily',
      ],
      'stage' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'onboarding',
      ],
      'risk_score' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
      'risk_reasons' => [
        'type' => 'blob',
        'not null' => FALSE,
        'serialize' => TRUE,
      ],
      'join_date' => [
        'type' => 'varchar',
        'length' => 10,
        'not null' => FALSE,
      ],
      'orientation_date' => [
        'type' => 'varchar',
        'length' => 10,
        'not null' => FALSE,
      ],
      'door_badge_status' => [
        'type' => 'varchar',
        'length' => 16,
        'not null' => FALSE,
      ],
      'serial_number_present' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'badge_count_total' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
      'badge_count_window' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
      'tenure_bucket' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => FALSE,
      ],
      'membership_type' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
      ],
      'last_badge_ts' => [
        'type' => 'int',
        'not null' => FALSE,
      ],
      'last_visit_ts' => [
        'type' => 'int',
        'not null' => FALSE,
      ],
      'visit_count_30d' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
      'payment_failed' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'payment_pause' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'payment_status' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
      ],
      'cancellation_followup' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
      ],
      'civicrm_do_not_phone' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'civicrm_do_not_email' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'civicrm_do_not_sms' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'civicrm_do_not_mail' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'preferred_outreach_method' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => FALSE,
      ],
      'last_outreach_ts' => [
        'type' => 'int',
        'not null' => FALSE,
      ],
      'outreach_status' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
      ],
      'last_contact_date' => [
        'type' => 'varchar',
        'length' => 10,
        'not null' => FALSE,
        'description' => 'Date of last contact attempt (YYYY-MM-DD)',
      ],
      'next_followup_date' => [
        'type' => 'varchar',
        'length' => 10,
        'not null' => FALSE,
        'description' => 'Date when member should reappear in queue (YYYY-MM-DD)',
      ],
      'contact_count' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Number of outreach attempts made',
      ],
      'created_at' => [
        'type' => 'int',
        'not null' => FALSE,
      ],
      'is_latest' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'uid_date' => ['uid', 'snapshot_date'],
      'stage' => ['stage'],
      'snapshot_type' => ['snapshot_type'],
      'risk_score' => ['risk_score'],
      'is_latest' => ['is_latest'],
      'next_followup_date' => ['next_followup_date'],
    ],
    ];
  }

  $schema['ms_member_outreach_log'] = [
    'description' => 'Log of all member outreach contact attempts for analytics.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
      ],
      'uid' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'Member user ID.',
      ],
      'contact_date' => [
        'type' => 'varchar',
        'length' => 10,
        'not null' => TRUE,
        'description' => 'Date contact was attempted (YYYY-MM-DD).',
      ],
      'contact_method' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'description' => 'phone, email, in_person, other.',
      ],
      'outcome' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'description' => 'Contact outcome.',
      ],
      'notes' => [
        'type' => 'text',
        'not null' => FALSE,
        'description' => 'Staff notes about conversation.',
      ],
      'followup_status' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
        'description' => 'Followup status applied after contact.',
      ],
      'staff_uid' => [
        'type' => 'int',
        'not null' => FALSE,
        'description' => 'Staff member who made contact.',
      ],
      'civicrm_activity_id' => [
        'type' => 'int',
        'not null' => FALSE,
        'description' => 'CiviCRM activity ID if created.',
      ],
      'sleep_days' => [
        'type' => 'int',
        'not null' => FALSE,
        'description' => 'Sleep period applied (days).',
      ],
      'created_at' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'Unix timestamp.',
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'idx_uid' => ['uid'],
      'idx_contact_date' => ['contact_date'],
      'idx_outcome' => ['outcome'],
      'idx_created_at' => ['created_at'],
    ],
  ];

  return $schema;
}

/**
 * Adds is_latest to member success snapshots.
 */
function makerspace_member_success_update_9007(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->fieldExists('ms_member_success_snapshot', 'is_latest')) {
    $schema->addField('ms_member_success_snapshot', 'is_latest', [
      'type' => 'int',
      'size' => 'tiny',
      'not null' => TRUE,
      'default' => 0,
    ]);
    $schema->addIndex('ms_member_success_snapshot', 'is_latest', ['is_latest'], [
      'fields' => [
        'is_latest' => [
          'type' => 'int',
          'size' => 'tiny',
          'not null' => TRUE,
          'default' => 0,
        ],
      ],
    ]);
  }
}

