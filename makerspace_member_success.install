/**
 * Ensures the Member Success view is installed for existing sites.
 */
function makerspace_member_success_update_9005(): void {
  makerspace_member_success_import_view_config();
  \Drupal::service('router.builder')->rebuild();
}

/**
 * Imports the member success queue view config if present.
 */
function makerspace_member_success_import_view_config(): void {
  $existing = \Drupal::config('views.view.member_success_queue');
  if (!$existing->isNew() && $existing->get('status')) {
    return;
  }

  $module_path = \Drupal::service('extension.list.module')->getPath('makerspace_member_success');
  $config_path = DRUPAL_ROOT . '/' . $module_path . '/config/install/views.view.member_success_queue.yml';
  if (!file_exists($config_path)) {
    return;
  }

  $data = Yaml::decode(file_get_contents($config_path));
  if (!is_array($data)) {
    return;
  }

  \Drupal::configFactory()->getEditable('views.view.member_success_queue')
    ->setData($data)
    ->save();
}

/**
 * Ensures the Member Success view is present/enabled.
 */
function makerspace_member_success_update_9006(): void {
  makerspace_member_success_import_view_config();
  \Drupal::service('router.builder')->rebuild();
}

/**
 * Adds outreach tracking fields for automatic queue sleep periods.
 */
function makerspace_member_success_update_9008(): void {
  $schema = \Drupal::database()->schema();

  // Add last_contact_date (DATE format YYYY-MM-DD)
  if (!$schema->fieldExists('ms_member_success_snapshot', 'last_contact_date')) {
    $schema->addField('ms_member_success_snapshot', 'last_contact_date', [
      'type' => 'varchar',
      'length' => 10,
      'not null' => FALSE,
      'description' => 'Date of last contact attempt (YYYY-MM-DD)',
    ]);
  }

  // Add next_followup_date (DATE format YYYY-MM-DD)
  if (!$schema->fieldExists('ms_member_success_snapshot', 'next_followup_date')) {
    $schema->addField('ms_member_success_snapshot', 'next_followup_date', [
      'type' => 'varchar',
      'length' => 10,
      'not null' => FALSE,
      'description' => 'Date when member should reappear in queue (YYYY-MM-DD)',
    ]);

    // Add index for filtering sleeping members
    $schema->addIndex('ms_member_success_snapshot', 'next_followup_date', ['next_followup_date'], [
      'fields' => [
        'next_followup_date' => [
          'type' => 'varchar',
          'length' => 10,
          'not null' => FALSE,
        ],
      ],
    ]);
  }

  // Add contact_count
  if (!$schema->fieldExists('ms_member_success_snapshot', 'contact_count')) {
    $schema->addField('ms_member_success_snapshot', 'contact_count', [
      'type' => 'int',
      'not null' => TRUE,
      'default' => 0,
      'description' => 'Number of outreach attempts made',
    ]);
  }
}

