        ],
        'contact_date' => [
          'type' => 'varchar',
          'length' => 10,
          'not null' => TRUE,
          'description' => 'Date contact was attempted (YYYY-MM-DD)',
        ],
        'contact_method' => [
          'type' => 'varchar',
          'length' => 32,
          'not null' => TRUE,
          'description' => 'phone, email, in_person, other',
        ],
        'outcome' => [
