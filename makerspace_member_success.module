        . '<li><strong>90+ days since last visit</strong> <em>(+30)</em></li>'
        . '</ul>'
        . '<p><strong>Known low-activity but healthy members:</strong> use <em>Log Contact</em> → mark <em>Outreach Exhausted</em>. Suppression resets automatically if the member changes stage.</p>',
      'actions' => '<ul>'
        . '<li><strong>60–89 days absent</strong> → friendly check-in email</li>'
        . '<li><strong>90+ days absent</strong> → phone call or personal outreach</li>'
        . '<li><strong>Confirmed healthy</strong> → log contact as Outreach Exhausted</li>'
