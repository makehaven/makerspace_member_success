/**
 * Implements hook_views_query_alter().
 */
function makerspace_member_success_views_query_alter(\Drupal\views\ViewExecutable $view, \Drupal\views\Plugin\views\query\QueryPluginBase $query): void {
  if ($view->id() !== 'member_success_queue') {
    return;
  }
  if (!$query instanceof \Drupal\views\Plugin\views\query\Sql) {
    return;
  }

  $alias = $query->ensureTable('ms_member_success_snapshot');
  $query->addWhere(0, "{$alias}.is_latest", 1);

  /** @var \Drupal\makerspace_member_success\Service\MemberSuccessQueueQueryApplier $query_applier */
  $query_applier = \Drupal::service('makerspace_member_success.queue_query_applier');
  $query_applier->applyDefaultOrdering($query, $alias);
  $query_applier->applyVisibilityFilters($query, $alias, MemberSuccessQueueRules::todayYmd());
}

/**
 * Implements hook_views_pre_render().
 */
function makerspace_member_success_views_pre_render(\Drupal\views\ViewExecutable $view) {
  if ($view->id() !== 'member_success_queue') {
    return;
  }

  // Add helpful header text to each queue display
  $guidance = [];

  // Add dashboard link for all queue displays
  $dashboard_link = '<div class="mb-2"><a href="/admin/makerspace/member-success/dashboard" class="btn btn-sm btn-outline-secondary">← Back to Dashboard</a></div>';

  // Add risk code legend (shown on all queues)
  $legend = '<div class="alert alert-light border mb-2">' .
    '<strong>Risk Codes:</strong> ' .
    '<span class="badge bg-danger">🔴 50+</span> Critical | ' .
    '<span class="badge bg-warning text-dark">20-49</span> Actionable | ' .
    '<strong>PAY</strong>=Payment Issue | ' .
    '<strong>DOOR</strong>=Door Badge Pending | ' .
    '<strong>KEY</strong>=Missing Serial | ' .
    '<strong>NO-BADGE</strong>=0 Badges (30d) | ' .
    '<strong>STALLED</strong>=&lt;4 Badges (90d) | ' .
    '<strong>ABSENT</strong>=Inactivity Tier Triggered' .
    '</div>';

  switch ($view->current_display) {
    case 'onboarding':
      $guidance = [
        '#type' => 'markup',
        '#markup' => $dashboard_link . $legend . '<div class="alert alert-info mb-3">' .
          '<h5>🏁 Onboarding Queue - Help New Members Get Started</h5>' .
          '<p><strong>What makes someone actionable here?</strong> Members flagged ONLY if:</p>' .
          '<ul>' .
          '<li>✅ <strong>14+ days since signup</strong> (2-week grace period for scheduling/completing orientation)</li>' .
          '<li>AND 🔴 Door badge not active (+20 points) - Haven\'t completed orientation quiz</li>' .
          '<li>OR 🟡 Missing key card serial (+10 points) - Haven\'t picked up or registered key</li>' .
          '</ul>' .
          '<p><strong>Grace Period:</strong> New members (< 14 days) are NOT flagged - they need time to schedule orientation.</p>' .
          '<p><strong>Priority:</strong> Members waiting longest (20+ days) shown first. These are genuinely stuck!</p>' .
          '<p><strong>Your Goal:</strong> Get them through orientation and set up with their key/badge.</p>' .
          '<p class="mb-0"><strong>Actions:</strong> Pending Door Badge → Quiz help email | Needs Key → Pickup email | Recent signup → Monitor, they\'re on track</p>' .
          '</div>',
        '#weight' => -100,
      ];
      break;

    case 'engagement':
      $guidance = [
        '#type' => 'markup',
        '#markup' => $dashboard_link . $legend . '<div class="alert alert-info mb-3">' .
          '<h5>🚀 Engagement Queue - Help Members Explore & Build Skills</h5>' .
          '<p><strong>What makes someone actionable here?</strong> Risk score ≥20 means:</p>' .
          '<ul>' .
          '<li>🔴 0 badges after 30 days (+20 points) - Activated but haven\'t used any tools</li>' .
          '<li>🟠 Less than 4 badges after 90 days (+20 points) - Started but stalled out</li>' .
          '</ul>' .
          '<p><strong>Priority:</strong> Most stalled members (0 badges) shown first. Early intervention builds habits!</p>' .
          '<p><strong>Your Goal:</strong> Get them earning badges and attending workshops.</p>' .
          '<p class="mb-0"><strong>Actions:</strong> Stalled (0 badges) → Workshop email | Low engagement (<4 badges) → Project ideas call | Active → Great job!</p>' .
          '</div>',
        '#weight' => -100,
      ];
      break;

    case 'retention':
      $guidance = [
        '#type' => 'markup',
        '#markup' => $dashboard_link . $legend . '<div class="alert alert-info mb-3">' .
          '<h5>❤️ Retention Queue - Keep Long-Term Members Engaged</h5>' .
          '<p><strong>What makes someone actionable here?</strong> Risk score ≥20 means:</p>' .
          '<ul>' .
          '<li>🟡 30+ days since last visit (+10 points)</li>' .
          '<li>🟠 60+ days since last visit (+20 points)</li>' .
          '<li>🔴 90+ days since last visit (+30 points)</li>' .
          '</ul>' .
          '<p><strong>Priority:</strong> Highest risk shown first, then longest absence. Start with 90+ days.</p>' .
          '<p><strong>Your Goal:</strong> Re-engage members who are drifting away.</p>' .
          '<p><strong>Tenure column:</strong> <code>new_member</code> means joined within configured new-member window (default 180 days); <code>sustaining</code> means longer-term member. Blank tenure usually means join date is missing on the member\'s main profile.</p>' .
          '<p><strong>Known low-activity but healthy members:</strong> Use <strong>Log Contact</strong> and check <strong>Mark as Outreach Exhausted</strong>. That suppresses repeat outreach in this stage.</p>' .
          '<p class="mb-0"><em>Important: suppression resets automatically if the member moves into a new stage (for example, payment failure in Recovery).</em></p>' .
          '</div>',
        '#weight' => -100,
      ];
      break;

    case 'recovery':
      $guidance = [
        '#type' => 'markup',
        '#markup' => $dashboard_link . $legend . '<div class="alert alert-danger mb-3">' .
          '<h5>💸 Recovery Queue - Prevent Payment-Related Churn</h5>' .
          '<p><strong>What makes someone actionable here?</strong> ONLY payment failures (risk = 50):</p>' .
          '<ul>' .
          '<li>🔴 Payment Failed (+50 points) - Credit card declined, need to update payment method URGENTLY</li>' .
          '</ul>' .
          '<p><strong>Note:</strong> Paused members are NOT in this queue - they intentionally paused with a planned resume date. No action needed for paused members.</p>' .
          '<p><strong>Priority:</strong> ALL members here are CRITICAL. Highest risk shown first. Contact within 24-48 hours!</p>' .
          '<p><strong>Your Goal:</strong> Recover failed payments and prevent cancellations.</p>' .
          '<p><strong>Actions:</strong> Payment Failed → URGENT call/email to update payment method</p>' .
          '<p class="mb-0"><strong>Recovery Tips:</strong> Offer free month, payment plan, or alternative membership level. Track outcome in "Log Contact" form.</p>' .
          '</div>',
        '#weight' => -100,
      ];
      break;

    case 'lifecycle':
      $guidance = [
        '#type' => 'markup',
        '#markup' => $dashboard_link . $legend . '<div class="alert alert-secondary mb-3">' .
          '<h5>📊 Lifecycle Overview - All Members by Stage</h5>' .
          '<p>This view shows all members and their current lifecycle stage. Use the stage-specific queues above for actionable lists.</p>' .
          '<p><strong>Stage Definitions:</strong></p>' .
          '<ul class="mb-0">' .
          '<li><strong>Onboarding:</strong> New member setting up access</li>' .
          '<li><strong>Engagement:</strong> First 6 months, building skills</li>' .
          '<li><strong>Retention:</strong> Long-term member staying active</li>' .
          '<li><strong>Recovery:</strong> Payment issue needs resolution</li>' .
          '</ul>' .
          '</div>',
        '#weight' => -100,
      ];
      break;
  }

  if (!empty($guidance)) {
    $view->attachment_before[] = $guidance;
  }

  // Add result count summary
  if (!empty($view->result)) {
    $total = count($view->result);

    // Get actionable count directly from database since Views result rows
    // don't reliably expose risk_score values
    $database = \Drupal::database();
    $query = $database->select('ms_member_success_snapshot', 'ms');
    $query->addExpression('COUNT(*)', 'count');
    $query->condition('ms.is_latest', 1);
    $query->condition('ms.snapshot_type', 'daily');
    $query->condition('ms.risk_score', 20, '>=');
    $today = MemberSuccessQueueRules::todayYmd();
    $resolved_statuses = MemberSuccessLifecycle::resolvedFollowupStatuses();

    $followup_date_group = $query->orConditionGroup()
      ->isNull('ms.next_followup_date')
      ->condition('ms.next_followup_date', $today, '<=');
    $query->condition($followup_date_group);

    $outreach_status_group = $query->orConditionGroup()
      ->isNull('ms.outreach_status')
      ->condition('ms.outreach_status', $resolved_statuses, 'NOT IN');
    $query->condition($outreach_status_group);

    $followup_status_group = $query->orConditionGroup()
      ->isNull('ms.member_followup_status')
      ->condition('ms.member_followup_status', $resolved_statuses, 'NOT IN');
    $query->condition($followup_status_group);

    // Filter by current display's stage
    $stage_map = [
      'onboarding' => MemberSuccessLifecycle::STAGE_ONBOARDING,
      'engagement' => MemberSuccessLifecycle::STAGE_ENGAGEMENT,
      'retention' => MemberSuccessLifecycle::STAGE_RETENTION,
      'recovery' => MemberSuccessLifecycle::STAGE_RECOVERY,
    ];

    if (isset($stage_map[$view->current_display])) {
      $query->condition('ms.stage', $stage_map[$view->current_display]);
    }

    $actionable = $query->execute()->fetchField();

    // Color code based on actionable percentage
    $color = 'text-success';
    if ($actionable > 0) {
      $percentage = ($actionable / $total) * 100;
      if ($percentage > 50) {
        $color = 'text-danger';
      }
      elseif ($percentage > 20) {
        $color = 'text-warning';
      }
    }

    $summary = [
      '#type' => 'markup',
      '#markup' => '<div class="alert alert-light border mb-3">' .
        '<strong>Showing ' . $total . ' members</strong> | ' .
        '<span class="' . $color . '">' . $actionable . ' actionable</span> (risk ≥ 20)' .
        '</div>',
      '#weight' => -90,
    ];

    $view->attachment_before[] = $summary;
  }
}
