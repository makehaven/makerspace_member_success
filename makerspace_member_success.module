      'scoring' => '<ul>'
        . '<li><strong>0 badges after 30 days</strong> <em>(+20)</em> — activated but haven\'t used any tools</li>'
        . '<li><strong>Fewer than 4 badges after 90 days</strong> <em>(+20)</em> — started but stalled out</li>'
        . '</ul>'
