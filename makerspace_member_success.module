/**
 * Implements hook_views_query_alter().
 */
function makerspace_member_success_views_query_alter(\Drupal\views\ViewExecutable $view, \Drupal\views\Plugin\views\query\QueryPluginBase $query): void {
  if ($view->id() !== 'member_success_queue') {
    return;
  }
  if (!$query instanceof \Drupal\views\Plugin\views\query\Sql) {
    return;
  }

  $alias = $query->ensureTable('ms_member_success_snapshot');
  $query->addWhere(0, "{$alias}.is_latest", 1);

  // Paused action queue should prioritize high-risk pauses (61+ days) while
  // lower-risk bulk handling remains in Queue Review.
  if ($view->current_display === 'paused') {
    $query->addWhere(0, "{$alias}.risk_score", 20, '>=');
  }

  // On the four lifecycle stage pages, filter by risk bucket so the list
  // default matches the "Actionable" count on the dashboard card. The bucket
  // is read from ?bucket= and defaults to "actionable".
  $stage_displays = ['onboarding', 'engagement', 'retention', 'recovery'];
  if (in_array($view->current_display, $stage_displays, TRUE)) {
    $request = \Drupal::requestStack()->getCurrentRequest();
    $bucket = \Drupal\makerspace_member_success\Support\MemberSuccessBuckets::normalize(
      $request ? $request->query->get('bucket') : NULL
    );
    // If the requested bucket is hidden on this stage, fall back to the
    // default so the query matches the highlighted tab.
    if (!\Drupal\makerspace_member_success\Support\MemberSuccessBuckets::isVisibleForStage($view->current_display, $bucket)) {
      $bucket = \Drupal\makerspace_member_success\Support\MemberSuccessBuckets::DEFAULT_BUCKET;
    }
    foreach (\Drupal\makerspace_member_success\Support\MemberSuccessBuckets::riskConditions($bucket) as [$op, $val]) {
      $query->addWhere(0, "{$alias}.risk_score", $val, $op);
    }
  }

  /** @var \Drupal\makerspace_member_success\Service\MemberSuccessQueueQueryApplier $query_applier */
  $query_applier = \Drupal::service('makerspace_member_success.queue_query_applier');
  $query_applier->applyDefaultOrdering($query, $alias);
  $query_applier->applyVisibilityFilters($query, $alias, MemberSuccessQueueRules::todayYmd());
}

/**
 * Implements hook_views_pre_render().
 */
function makerspace_member_success_views_pre_render(\Drupal\views\ViewExecutable $view) {
  if ($view->id() !== 'member_success_queue') {
    return;
  }

  $view->element['#attached']['library'][] = 'makerspace_member_success/dashboard';

  makerspace_member_success_adjust_queue_runtime_layout($view);

  $stage_map_for_buckets = [
    'onboarding' => MemberSuccessLifecycle::STAGE_ONBOARDING,
    'engagement' => MemberSuccessLifecycle::STAGE_ENGAGEMENT,
    'retention' => MemberSuccessLifecycle::STAGE_RETENTION,
    'recovery' => MemberSuccessLifecycle::STAGE_RECOVERY,
  ];

  // Stage pages get the new compact header: title + goal + status pulse,
  // then bucket tabs, then collapsed reference drawers. Other displays
  // (paused/lifecycle/default) keep their legacy guidance block.
  if (isset($stage_map_for_buckets[$view->current_display])) {
    // Drop the view-level intro paragraph inherited from the default display
    // header area — it's generic and lives above the title on every page.
    $view->header = [];

    $stage_key = $stage_map_for_buckets[$view->current_display];
    $view->attachment_before[] = _makerspace_member_success_build_stage_title_block($view->current_display, $stage_key);
    $view->attachment_before[] = _makerspace_member_success_build_bucket_tabs($view->current_display, $stage_key);
    $view->attachment_before[] = _makerspace_member_success_build_stage_drawers($view->current_display);
  }
  else {
    $guidance = [];
    $dashboard_link = '<div class="mb-2"><a href="/admin/makerspace/member-success/dashboard" class="btn btn-sm btn-outline-secondary">← Back to Dashboard</a></div>';
    $legend = '<div class="alert alert-light border mb-2">' .
      '<strong>Risk Codes:</strong> ' .
      '<span class="badge bg-danger">🔴 50+</span> Critical | ' .
      '<span class="badge bg-warning text-dark">20-49</span> Actionable | ' .
      '<strong>PAY</strong>=Payment Issue | ' .
      '<strong>DOOR</strong>=Door Badge Pending | ' .
      '<strong>KEY</strong>=Missing Serial | ' .
      '<strong>NO-BADGE</strong>=0 Badges (30d) | ' .
      '<strong>STALLED</strong>=&lt;4 Badges (90d) | ' .
      '<strong>ABSENT</strong>=Inactivity Tier Triggered' .
      '</div>';

    switch ($view->current_display) {
      case 'paused':
        $guidance = [
          '#type' => 'markup',
          '#markup' => $dashboard_link . $legend . '<div class="alert alert-warning mb-3">' .
            '<h5>⏸️ Paused Queue - Re-Engage Before Pause Expiry</h5>' .
            '<p><strong>What makes someone actionable here?</strong> Members on payment pause, prioritized as pause age approaches the limit.</p>' .
            '<ul>' .
            '<li>🟡 Days 1-60: Planned pause (low urgency)</li>' .
            '<li>🔴 Day 61+: High risk of churn if no return plan is set</li>' .
            '</ul>' .
            '<p><strong>Your Goal:</strong> Confirm return timing, offer extension/reactivation path, and prevent silent lapse.</p>' .
            '<p class="mb-0"><strong>Bulk processing:</strong> Use Queue Review for broad campaigns; this page is the person-by-person action queue.</p>' .
            '</div>',
          '#weight' => -100,
        ];
        break;

      case 'lifecycle':
        $guidance = [
          '#type' => 'markup',
          '#markup' => $dashboard_link . $legend . '<div class="alert alert-secondary mb-3">' .
            '<h5>📊 Lifecycle Overview - All Members by Stage</h5>' .
            '<p>This view shows all members and their current lifecycle stage. Use the stage-specific queues above for actionable lists.</p>' .
            '<p><strong>Stage Definitions:</strong></p>' .
            '<ul class="mb-0">' .
            '<li><strong>Onboarding:</strong> New member setting up access</li>' .
            '<li><strong>Engagement:</strong> First 6 months, building skills</li>' .
            '<li><strong>Retention:</strong> Long-term member staying active</li>' .
            '<li><strong>Recovery:</strong> Payment issue needs resolution</li>' .
            '</ul>' .
            '</div>',
          '#weight' => -100,
        ];
        break;
    }

    if (!empty($guidance)) {
      $view->attachment_before[] = $guidance;
    }
  }

  if ($view->current_display === 'recovery') {
    makerspace_member_success_attach_recovery_hidden_listing($view);
  }

  // Enrich onboarding rows with join_date so the "Days in Process" column
  // rendered by hook_preprocess_views_view_table() has data to work with.
  if ($view->id() === 'member_success_queue' && $view->current_display === 'onboarding' && !empty($view->result)) {
    $uids = [];
    foreach ($view->result as $row) {
      if (!empty($row->users_field_data_ms_member_success_snapshot_uid)) {
        $uids[] = (int) $row->users_field_data_ms_member_success_snapshot_uid;
      }
    }
    if ($uids) {
      $map = \Drupal::database()->select('ms_member_success_snapshot', 's')
        ->fields('s', ['uid', 'join_date'])
        ->condition('s.uid', $uids, 'IN')
        ->condition('s.is_latest', 1)
        ->condition('s.snapshot_type', 'daily')
        ->execute()
        ->fetchAllKeyed();
      foreach ($view->result as $row) {
        $uid = (int) ($row->users_field_data_ms_member_success_snapshot_uid ?? 0);
        $row->ms_member_success_snapshot_join_date = $map[$uid] ?? NULL;
      }
    }
  }
}

/**
 * Implements hook_preprocess_views_view_table().
 *
 * Injects a "Days in Process" column into the onboarding queue table. We do
 * this at render time (instead of editing the Views config) so the change
 * ships with the module without requiring a config import.
 */
function makerspace_member_success_preprocess_views_view_table(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!$view instanceof \Drupal\views\ViewExecutable) {
    return;
  }
  if ($view->id() !== 'member_success_queue' || $view->current_display !== 'onboarding') {
    return;
  }
  if (empty($variables['rows'])) {
    return;
  }

  // Insert header immediately after Member (name). If the expected column is
  // missing, append to the end — still visible, just less optimal.
  $new_header = [
    'content' => t('Days in Process'),
    'default_classes' => TRUE,
    'url' => NULL,
    'sort_indicator' => '',
    'class' => 'views-field views-field-ms-days-in-process',
  ];

  $insert_after = 'name';
  $header_keys = array_keys($variables['header']);
  $position = array_search($insert_after, $header_keys, TRUE);
  if ($position === FALSE) {
    $variables['header']['ms_days_in_process'] = $new_header;
  }
  else {
    $variables['header'] = _makerspace_member_success_array_insert_after(
      $variables['header'],
      $insert_after,
      'ms_days_in_process',
      $new_header
    );
  }

  $result_rows = $view->result;
  foreach ($variables['rows'] as $row_index => &$row) {
    $result_row = $result_rows[$row_index] ?? NULL;
    $join_date = $result_row->ms_member_success_snapshot_join_date ?? NULL;

    $cell_markup = _makerspace_member_success_render_days_in_process($join_date);

    $new_cell = [
      'content' => [
        ['field_output' => \Drupal\Core\Render\Markup::create($cell_markup)],
      ],
      'class' => 'views-field views-field-ms-days-in-process',
    ];

    $col_keys = array_keys($row['columns']);
    $col_position = array_search($insert_after, $col_keys, TRUE);
    if ($col_position === FALSE) {
      $row['columns']['ms_days_in_process'] = $new_cell;
    }
    else {
      $row['columns'] = _makerspace_member_success_array_insert_after(
        $row['columns'],
        $insert_after,
        'ms_days_in_process',
        $new_cell
      );
    }
  }
  unset($row);
}

/**
 * Renders the "Days in Process" cell markup with urgency color.
 */
function _makerspace_member_success_render_days_in_process(?string $join_date): string {
  if (!$join_date) {
    return '<span class="text-muted">—</span>';
  }
  $ts = strtotime($join_date . ' 00:00:00');
  if (!$ts) {
    return '<span class="text-muted">—</span>';
  }
  $days = (int) floor((time() - $ts) / 86400);

  // Mirror DaysWaitingField tiers: grace (<14), warning (14–20), danger (21+).
  if ($days >= 21) {
    $class = 'ms-days-danger';
  }
  elseif ($days >= 14) {
    $class = 'ms-days-warning';
  }
  elseif ($days >= 7) {
    $class = 'ms-days-info';
  }
  else {
    $class = 'ms-days-grace';
  }

  $formatted = htmlspecialchars(date('M j, Y', $ts), ENT_QUOTES, 'UTF-8');
  return sprintf(
    '<span class="ms-days-in-process %s" title="Joined %s">%d day%s</span>',
    $class,
    $formatted,
    $days,
    $days === 1 ? '' : 's'
  );
}

/**
 * Inserts a key/value pair into an associative array immediately after the
 * given key. Preserves order and returns the new array.
 */
function _makerspace_member_success_array_insert_after(array $source, string $after_key, string $new_key, $new_value): array {
  $out = [];
  foreach ($source as $k => $v) {
    $out[$k] = $v;
    if ($k === $after_key) {
      $out[$new_key] = $new_value;
    }
  }
  return $out;
}

