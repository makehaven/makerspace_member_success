/**
 * Builds the compact stage title block (icon + title + goal + status pulse).
 */
function _makerspace_member_success_build_stage_title_block(string $display_id, string $stage_key): array {
  $meta = _makerspace_member_success_stage_meta($display_id);

  /** @var \Drupal\makerspace_member_success\Service\MemberSuccessBucketCounter $counter */
  $counter = \Drupal::service('makerspace_member_success.bucket_counter');
  $counts = $counter->countsForStage($stage_key);
  $actionable = (int) ($counts[\Drupal\makerspace_member_success\Support\MemberSuccessBuckets::ACTIONABLE] ?? 0);
  $visible_total = (int) ($counts[\Drupal\makerspace_member_success\Support\MemberSuccessBuckets::ALL] ?? 0);

  $oldest_days = NULL;
  if (!empty($meta['date_column'])) {
    $oldest_days = _makerspace_member_success_oldest_actionable_days(
      $stage_key,
      $meta['date_column'],
      !empty($meta['date_is_ts'])
    );
  }

  // Pulse line pieces.
  $pulse_class = 'ms-pulse-calm';
  if ($actionable > 0) {
    $pulse_class = $actionable >= 10 ? 'ms-pulse-hot' : 'ms-pulse-warm';
  }

  $pulse_parts = [];
  $pulse_parts[] = sprintf(
    '<span class="ms-pulse-actionable"><strong>%d</strong> actionable</span>',
    $actionable
  );
  if ($oldest_days !== NULL && !empty($meta['date_label'])) {
    $pulse_parts[] = sprintf(
      '<span class="ms-pulse-oldest">%s: <strong>%d day%s</strong></span>',
      htmlspecialchars($meta['date_label'], ENT_QUOTES, 'UTF-8'),
      $oldest_days,
      $oldest_days === 1 ? '' : 's'
    );
  }
  $pulse_parts[] = sprintf('<span class="ms-pulse-total">%d visible</span>', $visible_total);
  $pulse_html = '<div class="ms-stage-pulse ' . $pulse_class . '">'
    . implode(' <span class="ms-pulse-sep">·</span> ', $pulse_parts)
    . '</div>';

  try {
    $dashboard_url = \Drupal\Core\Url::fromUserInput('/admin/makerspace/member-success/dashboard')->toString();
  }
  catch (\Exception $e) {
    $dashboard_url = '/admin/makerspace/member-success/dashboard';
  }

  $header_html = sprintf(
    '<div class="ms-stage-header">'
    . '<a href="%s" class="ms-stage-back">← Dashboard</a>'
    . '<div class="ms-stage-heading">'
    . '<span class="ms-stage-header-icon" aria-hidden="true">%s</span>'
    . '<div class="ms-stage-heading-text">'
    . '<h2 class="ms-stage-title">%s</h2>'
    . '<p class="ms-stage-goal">%s</p>'
    . '</div>'
    . '</div>'
    . '%s'
    . '</div>',
    htmlspecialchars($dashboard_url, ENT_QUOTES, 'UTF-8'),
    $meta['icon'],
    htmlspecialchars($meta['title'], ENT_QUOTES, 'UTF-8'),
    htmlspecialchars($meta['goal'], ENT_QUOTES, 'UTF-8'),
    $pulse_html
  );

  return [
    '#type' => 'markup',
    '#markup' => \Drupal\Core\Render\Markup::create($header_html),
    '#weight' => -100,
  ];
}

/**
 * Builds the three collapsed reference drawers for a stage page.
 */
function _makerspace_member_success_build_stage_drawers(string $display_id): array {
  $meta = _makerspace_member_success_stage_meta($display_id);
  $legend = _makerspace_member_success_risk_code_legend_html();

  $html = '<div class="ms-stage-drawers">'
    . '<details class="ms-drawer"><summary>How risk is scored</summary><div class="ms-drawer-body">' . $meta['scoring'] . '</div></details>'
    . '<details class="ms-drawer"><summary>Suggested actions</summary><div class="ms-drawer-body">' . $meta['actions'] . '</div></details>'
    . '<details class="ms-drawer"><summary>Risk code reference</summary><div class="ms-drawer-body">' . $legend . '</div></details>'
    . '</div>';

  return [
    '#type' => 'markup',
    '#markup' => \Drupal\Core\Render\Markup::create($html),
    '#weight' => -80,
  ];
}

/**
 * Shared risk-code legend markup (used in the drawers).
 */
function _makerspace_member_success_risk_code_legend_html(): string {
  return '<dl class="ms-legend-dl">'
    . '<dt>🔴 50+</dt><dd>Critical — immediate action</dd>'
    . '<dt>🟡 20–49</dt><dd>Actionable — follow up this week</dd>'
    . '<dt>PAY</dt><dd>Payment issue</dd>'
    . '<dt>DOOR</dt><dd>Door badge pending</dd>'
    . '<dt>KEY</dt><dd>Missing key serial</dd>'
    . '<dt>NO-BADGE</dt><dd>0 badges in 30 days</dd>'
    . '<dt>STALLED</dt><dd>&lt; 4 badges in 90 days</dd>'
    . '<dt>ABSENT</dt><dd>Inactivity tier triggered</dd>'
    . '</dl>';
}

/**
 * Returns the max age (in days) among visible, actionable rows for a stage.
 *
 * @param string $stage
 *   Lifecycle stage constant.
 * @param string $column
 *   Snapshot column to read (date string or unix timestamp).
 * @param bool $is_timestamp
 *   TRUE if the column stores a unix timestamp.
 */
function _makerspace_member_success_oldest_actionable_days(string $stage, string $column, bool $is_timestamp = FALSE): ?int {
  $today = MemberSuccessQueueRules::todayYmd();
  $resolved = MemberSuccessLifecycle::resolvedFollowupStatuses();

  $q = \Drupal::database()->select('ms_member_success_snapshot', 's');
  $q->condition('s.snapshot_type', 'daily');
  $q->condition('s.is_latest', 1);
  $q->condition('s.stage', $stage);
  $q->condition('s.risk_score', 20, '>=');
  $q->isNotNull('s.' . $column);

  $fd = $q->orConditionGroup()
    ->isNull('s.next_followup_date')
    ->condition('s.next_followup_date', $today, '<=');
  $q->condition($fd);

  if (!empty($resolved)) {
    $os = $q->orConditionGroup()
      ->isNull('s.outreach_status')
      ->condition('s.outreach_status', $resolved, 'NOT IN');
    $q->condition($os);
    $mfs = $q->orConditionGroup()
      ->isNull('s.member_followup_status')
      ->condition('s.member_followup_status', $resolved, 'NOT IN');
    $q->condition($mfs);
  }

  $q->addExpression('MIN(s.' . $column . ')', 'oldest');
  $val = $q->execute()->fetchField();
  if ($val === FALSE || $val === NULL || $val === '') {
    return NULL;
  }

  $ts = $is_timestamp ? (int) $val : strtotime($val . ' 00:00:00');
  if (!$ts) {
    return NULL;
  }
  return (int) floor((time() - $ts) / 86400);
}

/**
 * Builds the risk-bucket tab strip render array for a stage page.
 *
 * @param string $display_id
 *   Views display id (onboarding/engagement/retention/recovery).
 * @param string $stage
 *   Lifecycle stage constant (MemberSuccessLifecycle::STAGE_*).
 */
function _makerspace_member_success_build_bucket_tabs(string $display_id, string $stage): array {
  /** @var \Drupal\makerspace_member_success\Service\MemberSuccessBucketCounter $counter */
  $counter = \Drupal::service('makerspace_member_success.bucket_counter');
  $counts = $counter->countsForStage($stage);

  $request = \Drupal::requestStack()->getCurrentRequest();
  $raw_bucket = $request ? $request->query->get('bucket') : NULL;
  $active = \Drupal\makerspace_member_success\Support\MemberSuccessBuckets::normalize($raw_bucket);
  // If the URL asks for a bucket this stage doesn't render (e.g. ?bucket=watch
  // on engagement/recovery), fall back to Actionable so we don't highlight a
  // hidden tab.
  if (!\Drupal\makerspace_member_success\Support\MemberSuccessBuckets::isVisibleForStage($display_id, $active)) {
    $active = \Drupal\makerspace_member_success\Support\MemberSuccessBuckets::DEFAULT_BUCKET;
  }

  // Preserve existing query params (sort, order, page, etc.) when switching
  // buckets so table sort and pager state survive tab clicks. We drop `page`
  // because switching buckets changes the result set length.
  $base_query = $request ? $request->query->all() : [];
  unset($base_query['bucket'], $base_query['page']);

  $tabs_html = '<ul class="nav nav-pills mb-2 ms-bucket-tabs" role="tablist">';
  foreach (\Drupal\makerspace_member_success\Support\MemberSuccessBuckets::orderForStage($display_id) as $bucket) {
    $label = \Drupal\makerspace_member_success\Support\MemberSuccessBuckets::label($bucket);
    $desc = \Drupal\makerspace_member_success\Support\MemberSuccessBuckets::description($bucket);
    $count = (int) ($counts[$bucket] ?? 0);
    $is_active = ($bucket === $active);

    try {
      $url = \Drupal\Core\Url::fromRoute(
        'view.member_success_queue.' . $display_id,
        [],
        ['query' => $base_query + ['bucket' => $bucket]]
      )->toString();
    }
    catch (\Symfony\Component\Routing\Exception\RouteNotFoundException $e) {
      $url = '?bucket=' . urlencode($bucket);
    }

    $link_class = $is_active ? 'active' : '';
    $tabs_html .= sprintf(
      '<li><a class="%s" href="%s" title="%s">%s<span class="ms-bucket-count">%d</span></a></li>',
      htmlspecialchars($link_class, ENT_QUOTES, 'UTF-8'),
      htmlspecialchars($url, ENT_QUOTES, 'UTF-8'),
      htmlspecialchars($desc, ENT_QUOTES, 'UTF-8'),
      htmlspecialchars($label, ENT_QUOTES, 'UTF-8'),
      $count
    );
  }
  $tabs_html .= '</ul>';

  $active_desc = \Drupal\makerspace_member_success\Support\MemberSuccessBuckets::description($active);
  $active_label = \Drupal\makerspace_member_success\Support\MemberSuccessBuckets::label($active);
  $helper = sprintf(
    '<p class="text-muted small mb-3 ms-bucket-hint">Showing <strong>%s</strong> (%s). Snoozed members are hidden from every tab until their sleep expires.</p>',
    htmlspecialchars($active_label, ENT_QUOTES, 'UTF-8'),
    htmlspecialchars($active_desc, ENT_QUOTES, 'UTF-8')
  );

  return [
    '#type' => 'markup',
    '#markup' => \Drupal\Core\Render\Markup::create($tabs_html . $helper),
    '#weight' => -90,
  ];
}

/**
 * Applies runtime layout fixes for queue displays.
 */
function makerspace_member_success_adjust_queue_runtime_layout(\Drupal\views\ViewExecutable $view): void {
  if ($view->current_display === 'engagement') {
    makerspace_member_success_adjust_engagement_columns($view);
  }

  if (in_array($view->current_display, ['recovery', 'paused'], TRUE)) {
    makerspace_member_success_adjust_recovery_columns($view);
  }

  if ($view->current_display === 'lifecycle') {
    makerspace_member_success_hide_duplicate_lifecycle_fields($view);
  }
}

/**
 * Adds empty-state guidance and hidden-row context to the recovery queue.
 */
function makerspace_member_success_attach_recovery_hidden_listing(\Drupal\views\ViewExecutable $view): void {
  $today = MemberSuccessQueueRules::todayYmd();
  $rows = \Drupal::database()->select('ms_member_success_snapshot', 'ms')
    ->fields('ms', [
      'uid',
      'membership_type',
      'risk_score',
      'payment_failed',
      'payment_pause',
      'next_followup_date',
      'outreach_status',
      'member_followup_status',
    ])
    ->condition('ms.is_latest', 1)
    ->condition('ms.snapshot_type', 'daily')
    ->condition('ms.stage', MemberSuccessLifecycle::STAGE_RECOVERY)
    ->orderBy('ms.risk_score', 'DESC')
    ->execute()
    ->fetchAll();

  if (empty($rows)) {
    return;
  }

  $uids = [];
  foreach ($rows as $row) {
    $uids[] = (int) $row->uid;
  }
  $users = \Drupal::entityTypeManager()->getStorage('user')->loadMultiple($uids);

  $snoozed_rows = [];
  $suppressed_rows = [];

  foreach ($rows as $row) {
    $is_visible = MemberSuccessQueueRules::isQueueVisible(
      $row->next_followup_date,
      $row->outreach_status,
      $row->member_followup_status,
      $today
    );
    if ($is_visible) {
      continue;
    }

    $reason = makerspace_member_success_describe_hidden_recovery_reason($row, $today);
    
    // Determine if suppressed or snoozed.
    // Suppressed takes precedence if both apply.
    $is_suppressed = !MemberSuccessQueueRules::isStatusVisible($row->outreach_status) ||
                     !MemberSuccessQueueRules::isStatusVisible($row->member_followup_status);

    $uid = (int) $row->uid;
    $user = $users[$uid] ?? NULL;
    $member_label = $user ? $user->getDisplayName() : 'User ' . $uid;
    $member_link = $user
      ? Link::fromTextAndUrl($member_label, Url::fromRoute('entity.user.canonical', ['user' => $uid]))->toString()
      : $member_label;

    $action_parts = [];
    try {
      $log_url = Url::fromRoute('makerspace_member_success.log_contact', ['user' => $uid]);
      if ($log_url->access(\Drupal::currentUser())) {
        $action_parts[] = Link::fromTextAndUrl('Log Interaction', $log_url)->toString();
      }
    }
    catch (\Exception $e) {
      // Skip action link if the route or access check fails.
    }

    $action_parts[] = makerspace_member_success_suggest_hidden_recovery_action($row);

    $render_row = [
      'member' => [
        'data' => ['#markup' => (string) $member_link],
      ],
      'membership_type' => [
        'data' => ['#plain_text' => (string) ($row->membership_type ?? '')],
      ],
      'risk' => [
        'data' => ['#plain_text' => (string) $row->risk_score],
      ],
      'hidden_reason' => [
        'data' => ['#plain_text' => $reason],
      ],
      'status' => [
        'data' => ['#plain_text' => (string) ($row->member_followup_status ?: $row->outreach_status ?: 'pending')],
      ],
      'suggested_action' => [
        'data' => ['#markup' => implode(' <span class="text-muted">|</span> ', $action_parts)],
      ],
    ];

    if ($is_suppressed) {
      $suppressed_rows[] = $render_row;
    }
    else {
      $snoozed_rows[] = $render_row;
    }
  }

  if (empty($snoozed_rows) && empty($suppressed_rows)) {
    return;
  }

  if (empty($view->result)) {
    $view->attachment_after[] = [
      '#type' => 'markup',
      '#markup' => '<div class="alert alert-info mt-3">' .
        '<h5>No members need immediate recovery outreach today</h5>' .
        '<p class="mb-2">The actionable recovery queue is empty because all current recovery members are either snoozed until a future follow-up date or already marked with a resolved/suppressed status.</p>' .
        '<p class="mb-0"><strong>Current hidden counts:</strong> ' . (count($snoozed_rows) + count($suppressed_rows)) . ' hidden total, ' . count($snoozed_rows) . ' snoozed for later follow-up, ' . count($suppressed_rows) . ' suppressed by status.</p>' .
        '</div>',
      '#weight' => 10,
    ];
  }

  $table_header = [
    'member' => 'Member',
    'membership_type' => 'Membership Type',
    'risk' => 'Risk',
    'hidden_reason' => 'Hidden Reason',
    'status' => 'Outreach Status',
    'suggested_action' => 'Suggested Action',
  ];

  if (!empty($snoozed_rows)) {
    $view->attachment_after[] = [
      '#type' => 'details',
      '#title' => t('Snoozed Recovery Members (@count)', ['@count' => count($snoozed_rows)]),
      '#open' => TRUE,
      '#weight' => 20,
      'help' => [
        '#type' => 'markup',
        '#markup' => '<p class="text-muted">These members are still active work, but are deferred until their follow-up date.</p>',
      ],
      'table' => [
        '#type' => 'table',
        '#header' => $table_header,
        '#rows' => $snoozed_rows,
        '#empty' => t('No snoozed recovery members found.'),
        '#attributes' => ['class' => ['ms-snoozed-recovery-table']],
      ],
    ];
  }

  if (!empty($suppressed_rows)) {
    $view->attachment_after[] = [
      '#type' => 'details',
      '#title' => t('Suppressed Recovery Members (@count)', ['@count' => count($suppressed_rows)]),
      '#open' => FALSE,
      '#weight' => 30,
      'help' => [
        '#type' => 'markup',
        '#markup' => '<p class="text-muted">These members are effectively closed or parked. They will not return to the queue unless their status changes or the stage resets.</p>',
      ],
      'table' => [
        '#type' => 'table',
        '#header' => $table_header,
        '#rows' => $suppressed_rows,
        '#empty' => t('No suppressed recovery members found.'),
        '#attributes' => ['class' => ['ms-suppressed-recovery-table']],
      ],
    ];
  }
}

/**
 * Builds a readable reason for why a recovery member is hidden.
 */
function makerspace_member_success_describe_hidden_recovery_reason(object $row, string $today): string {
  if (!empty($row->next_followup_date) && $row->next_followup_date > $today) {
    return 'Snoozed until ' . $row->next_followup_date;
  }

  $status = $row->member_followup_status ?: $row->outreach_status;
  return match ($status) {
    MemberSuccessLifecycle::FOLLOWUP_CONFIRMED_CANCELLATION => 'Suppressed after confirmed cancellation',
    MemberSuccessLifecycle::FOLLOWUP_OUTREACH_EXHAUSTED => 'Suppressed after outreach exhausted',
    MemberSuccessLifecycle::FOLLOWUP_NO_ACTION_NEEDED => 'Suppressed as no action needed',
    MemberSuccessLifecycle::FOLLOWUP_NEEDS_REVIEW => 'Suppressed pending manual review',
    default => 'Hidden by current queue visibility rules',
  };
}

/**
 * Returns a short operator-facing suggestion for a hidden recovery member.
 */
function makerspace_member_success_suggest_hidden_recovery_action(object $row): string {
  if (!empty($row->next_followup_date)) {
    return 'Follow up on or after ' . $row->next_followup_date;
  }

  $status = $row->member_followup_status ?: $row->outreach_status;
  return match ($status) {
    MemberSuccessLifecycle::FOLLOWUP_CONFIRMED_CANCELLATION => 'Review only if the cancellation status looks wrong',
    MemberSuccessLifecycle::FOLLOWUP_OUTREACH_EXHAUSTED => 'Resume outreach only if you want to override exhaustion',
    MemberSuccessLifecycle::FOLLOWUP_NO_ACTION_NEEDED => 'No outreach needed unless the payment issue reopens',
    MemberSuccessLifecycle::FOLLOWUP_NEEDS_REVIEW => 'Resolve the review state before resuming outreach',
    default => 'Review history before changing outreach status',
  };
}

/**
 * Adds access context columns to engagement queue.
 */
function makerspace_member_success_adjust_engagement_columns(\Drupal\views\ViewExecutable $view): void {
  if (empty($view->style_plugin) || empty($view->style_plugin->options)) {
    return;
  }

  foreach (['last_visit_ts', 'visit_count_30d'] as $field_id) {
    if (!empty($view->field[$field_id])) {
      $view->field[$field_id]->options['exclude'] = FALSE;
    }
  }
  if (!empty($view->field['last_visit_ts'])) {
    $view->field['last_visit_ts']->options['label'] = 'Last Door Entry';
  }
  if (!empty($view->field['visit_count_30d'])) {
    $view->field['visit_count_30d']->options['label'] = 'Visits (30d)';
  }

  $columns = [
    'name' => 'name',
    'membership_type' => 'membership_type',
    'tenure_bucket' => 'tenure_bucket',
    'last_visit_ts' => 'last_visit_ts',
    'visit_count_30d' => 'visit_count_30d',
    'badge_count_window' => 'badge_count_window',
    'badge_count_total' => 'badge_count_total',
    'last_badge_ts' => 'last_badge_ts',
    'risk_score' => 'risk_score',
    'action_engagement' => 'action_engagement',
  ];
  $info = [
    'name' => ['sortable' => TRUE, 'default_sort_order' => 'asc', 'align' => '', 'separator' => '', 'empty_column' => FALSE, 'responsive' => ''],
    'membership_type' => ['sortable' => TRUE, 'default_sort_order' => 'asc', 'align' => '', 'separator' => '', 'empty_column' => FALSE, 'responsive' => ''],
    'tenure_bucket' => ['sortable' => TRUE, 'default_sort_order' => 'asc', 'align' => '', 'separator' => '', 'empty_column' => FALSE, 'responsive' => ''],
    'last_visit_ts' => ['sortable' => TRUE, 'default_sort_order' => 'asc', 'align' => '', 'separator' => '', 'empty_column' => FALSE, 'responsive' => ''],
    'visit_count_30d' => ['sortable' => TRUE, 'default_sort_order' => 'desc', 'align' => '', 'separator' => '', 'empty_column' => FALSE, 'responsive' => ''],
    'badge_count_window' => ['sortable' => TRUE, 'default_sort_order' => 'asc', 'align' => '', 'separator' => '', 'empty_column' => FALSE, 'responsive' => ''],
    'badge_count_total' => ['sortable' => TRUE, 'default_sort_order' => 'desc', 'align' => '', 'separator' => '', 'empty_column' => FALSE, 'responsive' => ''],
    'last_badge_ts' => ['sortable' => TRUE, 'default_sort_order' => 'asc', 'align' => '', 'separator' => '', 'empty_column' => FALSE, 'responsive' => ''],
    'risk_score' => ['sortable' => TRUE, 'default_sort_order' => 'desc', 'align' => '', 'separator' => '', 'empty_column' => FALSE, 'responsive' => ''],
    'action_engagement' => ['sortable' => FALSE, 'default_sort_order' => 'asc', 'align' => '', 'separator' => '', 'empty_column' => FALSE, 'responsive' => ''],
  ];

  $view->style_plugin->options['columns'] = $columns;
  $view->style_plugin->options['info'] = $info;
