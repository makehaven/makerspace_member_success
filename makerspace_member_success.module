        . '<li><strong>Pending Door Badge</strong> → orientation-quiz help email</li>'
        . '<li><strong>Needs Key</strong> → key-pickup email</li>'
        . '<li><strong>Recent signup</strong> → monitor; they\'re on track</li>'
